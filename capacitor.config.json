{
  "appId": "com.biocode.nutriplan",
  "appName": "NutriPlan",
  "webDir": "capacitor-shell",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_nutriplan",
      "iconColor": "#009A9E"
    },
    "GoogleAuth": {
      "_note": "serverClientId is overwritten at build time by the CI pipeline using the GOOGLE_WEB_CLIENT_ID GitHub Actions secret. On Android, strings.xml server_client_id takes precedence.",
      "scopes": [
        "profile",
        "email",
        "https://www.googleapis.com/auth/drive.appdata"
      ],
      "serverClientId": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "_note": "Системният splash покрива празния кадър на WebView; уеб стартовият екран (index.html, същият цвят и икона) го поема без мигване.",
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "launchFadeOutDuration": 220,
      "backgroundColor": "#042F2E",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "_note": "Начален цвят = splash; после app.js го сменя според темата и отворените листове.",
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#042F2E"
    }
  },
  "android": {
    "minWebViewVersion": 60,
    "allowMixedContent": false,
    "backgroundColor": "#042F2E"
  }
}
